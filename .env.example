# Postgres. On Railway, a reference to the database service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# The Railway volume's mount path. The Dockerfile sets it, so the service
# needn't. Frames, plans, models, thumbnails and published bundles live here;
# without a volume they vanish on every deploy.
DATA_DIR=/data

PORT=3000

# The shared team code (spec §13). Set it on the Railway service by hand and
# never commit it. Production refuses to start without one of at least 8
# characters; leave it unset locally.
TEAM_CODE=

# NODE_ENV=production is set by the Dockerfile.

# Optional overrides
SESSION_TTL_HOURS=336
LOCK_TTL_SECONDS=300
