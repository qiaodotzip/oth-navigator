OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Teammate's retrieval backend (FastAPI). When set, an intent the local resolver
# isn't confident about is forwarded here. If unset or unreachable, the app
# falls back to the local result, so nothing breaks.
VITE_RETRIEVAL_API=http://127.0.0.1:8000

# Deep-link target for off-site / "Start in App" services. When set, the
# "Start in App" button opens this URL; otherwise it shows a placeholder.
VITE_OTH_APP_URL=

# Real foot-traffic toggle. OFF by default so `npm run build:popular-times:real`
# does nothing (no API credits spent) and the app keeps the modeled/fake curves.
# Set to true ONLY when you want to spend BestTime credits on a live pull.
ENABLE_REAL_DATA=false

# BestTime.app foot-traffic API (https://besttime.app). Free tier.
# Private key creates/refreshes forecasts; public key reads live busyness.
# Only used when ENABLE_REAL_DATA=true.
BESTTIME_API_KEY_PRIVATE=pri_...
BESTTIME_API_KEY_PUBLIC=pub_...
