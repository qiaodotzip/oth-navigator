OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Teammate's retrieval backend (FastAPI). When set, an intent the local resolver
# isn't confident about is forwarded here. If unset or unreachable, the app
# falls back to the local result, so nothing breaks.
VITE_RETRIEVAL_API=http://127.0.0.1:8000

# Deep-link target for off-site / "Start in App" services. When set, the
# "Start in App" button opens this URL; otherwise it shows a placeholder.
VITE_OTH_APP_URL=
