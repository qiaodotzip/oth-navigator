node_modules
dist
.env
.env.local
*.log
.DS_Store
*.tsbuildinfo

# local scratch from the round-trip smoke check
scripts/.context.glb

# Exported frames for labelling. A single walkthrough is hundreds of megabytes
# of 4K stills, and none of it belongs in git — the frames live in the asset
# store and the proposals go back through survey:import.
survey-out/frames/
**/survey-out/*/frames/

# Playwright's output from the smoke test
e2e/test-results/

# Planning notes, scratch and the brainstorm server's local state — none of it
# belongs to anyone but the machine it was written on, and `.last-token` in
# there is a credential. The test lock script is the exception: it is the only
# supported way to run the suite, so it has to survive a fresh clone.
.superpowers/*
!.superpowers/run-tests.sh

# Python bytecode from the helper scripts
__pycache__/
*.pyc
