{
  "name": "oth-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @oth/server",
    "start": "npm run start --workspace @oth/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p e2e/tsconfig.json",
    "build": "npm run build --workspace @oth/editor",
    "invite": "npm run start --workspace @oth/server -- invite",
    "seed": "npm run start --workspace @oth/server -- seed",
    "trace": "npm run start --workspace @oth/server -- trace",
    "survey:export": "npm run start --workspace @oth/server -- survey:export",
    "survey:import": "npm run start --workspace @oth/server -- survey:import",
    "survey:tidy": "npm run start --workspace @oth/server -- survey:tidy",
    "data:export": "npm run start --workspace @oth/server -- data:export",
    "data:import": "npm run start --workspace @oth/server -- data:import",
    "plans:one-per-floor": "npm run start --workspace @oth/server -- plans:one-per-floor",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "plan:l1": "npm run start --workspace @oth/server -- plan:l1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
